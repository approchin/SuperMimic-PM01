# The released 65k binaries are versioned; ignore other local model outputs.
/models/*.pt
/models/*.onnx
!/models/actor_0000065000.pt
!/models/actor_65000_fp32.onnx
/models/*.engine

# Local environments, caches and generated experiment artifacts.
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
/build/
/dist/
/local_export/
/runs/
/logs/
.env
.env.*
!.env.example

# Private working records must stay outside this publication snapshot.
.ops/
*.log
